" y="870" width="260" height="64" as="geometry"/></mxCell><mxCell id="c43" value='&lt;b&gt;Reviewer reads the diff, clicks Sync&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;opacity:0.85;"&gt;or: argocd app sync &amp;lt;name&amp;gt;&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#D6B656;fontColor=#232F3E;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1030" y="960" width="260" height="64" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;envs/prod/values.yaml&lt;/b&gt;&lt;br&gt;image tag (promoted from dev)&lt;br&gt;HPA 3-12 replicas at 65% CPU&lt;br&gt;requests 250m / 256Mi&lt;br&gt;topologySpread across nodes&lt;br&gt;PDB maxUnavailable 1&lt;br&gt;host shop.example.com" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#CCCCCC;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1340" y="620" width="270" height="150" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;Rollback&lt;/b&gt; = git revert on main (dev) or on the promotion PR (prod); Argo CD converges to the previous tag." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#CCCCCC;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1340" y="800" width="270" height="90" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;Same chart, same sync waves&lt;/b&gt;: only envs/&amp;lt;env&amp;gt;/values.yaml and the autoSync flag differ." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#CCCCCC;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1340" y="920" width="270" height="70" as="geometry"/></mxCell><mxCell id="c47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blo