xCell><mxCell id="c73" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#13AA52;strokeWidth=2;fontSize=10;fontColor=#13AA52;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8888888888888888;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c40" target="c46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c74" value="OTLP&lt;br&gt;:4318" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7280;strokeWidth=2;fontSize=10;fontColor=#6B7280;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=1;exitY=0.31;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c30" target="c53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c75" value="scrape&lt;br&gt;:9464" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7280;strokeWidth=2;fontSize=10;fontColor=#6B7280;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=1;exitY=0.92;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c30" target="c57"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1380" y="450"/><mxPoint x="1380" y="735"/></Array></mxGeometry></mxCell><mxCell id="c76" value="OTLP :4317" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7280;strokeWidth=2;fontSize=10;fontColor=#6B7280;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="c53" target="c54"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c77" value="TraceQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7280;strokeWidth=2;fontSize=10;fontColor=#6B7280;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=0.35;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c54" target="c55"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c78" value="PromQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7280;strokeWidth=2;fontSize=10;fontColor=#6B7280;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=0.35;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c57" target="c55"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c79" value="alerts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#B3261E;strokeWidth=2;fontSize=10;fontColor=#B3261E;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="c57" target="c58"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="2 GitOps delivery flow" id="2-gitops-delivery-flow"><mxGraphModel dx="1500" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value='&lt;b style="font-size:20px;"&gt;GitOps delivery flow&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#666;"&gt;GitHub Actions · GHCR · Argo CD app-of-apps · dev auto-sync · prod manual sync&lt;/span&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="8" width="1900" height="52" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b&gt;Developer&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;opacity:0.85;"&gt;feature branch / pull request&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#999999;fontColor=#232F3E;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="20" y="165" width="180" height="70" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b&gt;GitHub repo (main)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;opacity:0.85;"&gt;andresazcona/k8s-gitops-platform&lt;br&gt;charts · apps · envs · gitops · platform&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#24292F;fontColor=#232F3E;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="290" y="140" width="230" height="120" as="geometry"/></mxCell><mxCell id="c6" value="GitHub Actions · ci.yml, promote.yml (no cloud credentials)" style="rounded=1;dashed=1;dashPattern=8 4;arcSize=3;verticalAlign=top;align=left;html=1;fontStyle=1;fontSize=12;fontColor=#24292F;fillColor=#F6F8FA;strokeColor=#24292F;strokeWidth=1.5;spacingLeft=12;spacingTop=8;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="620" y="110" width="700" height="340" as="geometry"/></mxCell><mxCell id="c7" value='&lt;b&gt;unit&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;opacity:0.85;"&gt;node --test x4&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#24292F;strokeColor=none;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="c6"><mxGeometry x="15" y="50" width="150" height="64" as="geometry"/></mxCell><mxCell id="c8" value='&lt;b&gt;validate&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;opacity:0.85;"&gt;helm lint + template&lt;br&gt;kubeconform -strict&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#24292F;strokeColor=none;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="c6"><mxGeometry x="190" y="50" width="150" height="64" as="geometry"/></mxCell><mxCell id="c9" value='&lt;b&gt;e2e&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;opacity:0.85;"&gt;kind + docker build&lt;br&gt;helm install + k6 smoke&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#24292F;strokeColor=none;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="c6"><mxGeometry x="365" y="50" width="150" height="64" as="geometry"/></mxCell><mxCell id="c10" value='&lt;b&gt;release (main only)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;opacity:0.85;"&gt;build + push :sha&lt;br&gt;bump envs/dev tag&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#24292F;strokeColor=none;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="c6"><mxGeometry x="540" y="50" width="150" height="64" as="geometry"/></mxCell><mxCell id="c11" value="Pull requests run unit + validate + e2e. Only a push to main also runs release. Images are built once and tagged with the commit SHA (immutable)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#CCCCCC;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="635" y="260" width="360" height="66" as="geometry"/></mxCell><mxCell id="c12" value='&lt;b&gt;promote (manual dispatch)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;opacity:0.85;"&gt;opens a PR: envs/prod tag := dev tag&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#24292F;strokeColor=none;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="c6"><mxGeometry x="390" y="240" width="300" height="70" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeC