 width="360" height="70" as="geometry"/></mxCell><mxCell id="c55" value='&lt;b&gt;Grafana&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;opacity:0.85;"&gt;RED + SLO dashboard · Tempo datasource&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F5A800;strokeColor=none;fontColor=#232F3E;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1470" y="490" width="250" height="70" as="geometry"/></mxCell><mxCell id="c56" value="ConfigMap&lt;br&gt;dashboard" style="html=1;dashed=0;fillColor=#326CE5;strokeColor=#ffffff;fontColor=#232F3E;fontSize=11;align=center;points=[[0.005,0.63,0],[0.1,0.2,0],[0.9,0.2,0],[0.5,0,0],[0.995,0.63,0],[0.72,0.99,0],[0.5,1,0],[0.28,0.99,0]];verticalLabelPosition=bottom;verticalAlign=top;shape=mxgraph.kubernetes.icon;prIcon=cm;" vertex="1" parent="c51"><mxGeometry x="320" y="385" width="36" height="35" as="geometry"/></mxCell><mxCell id="c57" value='&lt;b&gt;Prometheus&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;opacity:0.85;"&gt;ServiceMonitor scrape :9464 · SLO rules&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#E6522C;strokeColor=none;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1470" y="700" width="360" height="70" as="geometry"/></mxCell><mxCell id="c58" value='&lt;b&gt;Alertmanager&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:10px;opacity:0.85;"&gt;ErrorBudgetFastBurn · LatencySLOBreach&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#B3261E;strokeColor=none;fontColor=#ffffff;fontSize=12;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1470" y="850" width="360" height="70" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b&gt;kube-prometheus-stack 92.3.1&lt;/b&gt; also brings kube-state-metrics, node-exporter and the operator; ingress-nginx metrics are scraped too." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#CCCCCC;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1470" y="960" width="360" height="80" as="geometry"/></mxCell><mxCell id="c60" value="&lt;b&gt;Per-service chart&lt;/b&gt;&lt;br&gt;Deployment + Service (:80 to :3000)&lt;br&gt;HPA on CPU (dev 1-4, prod 3-12)&lt;br&gt;PodDisruptionBudget&lt;br&gt;ServiceMonitor on :9464 (OTel Prometheus exporter)&lt;br&gt;PrometheusRule (SLO) on the gateway&lt;br&gt;NetworkPolicy: default deny + explicit peers" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#CCCCCC;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="520" y="750" width="250" height="190" as="geometry"/></mxCell><mxCell id="c61" value="&lt;b&gt;Hardening&lt;/b&gt;&lt;br&gt;non-root uid 1000, seccomp RuntimeDefault&lt;br&gt;read-only root fs, drop ALL capabilities&lt;br&gt;no service-account token&lt;br&gt;RollingUpdate maxUnavailable 0&lt;br&gt;preStop sleep 5s (no dropped requests)&lt;br&gt;topology spread across nodes (prod)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#CCCCCC;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="795" y="750" width="250" height="190" as="geometry"/></mxCell><mxCell id="c62" value="&lt;b&gt;dev vs prod&lt;/b&gt;&lt;br&gt;dev: 1-4 replicas, 50m CPU request&lt;br&gt;auto-sync, prune, self-heal&lt;br&gt;prod: 3-12 replicas, 250m CPU request&lt;br&gt;manual sync, 1 pod max unavailable&lt;br&gt;host: shop.example.com" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#CCCCCC;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1070" y="750" width="250" height="190" as="geometry"/></mxCell><mxCell id="c63" value="&lt;b&gt;Why a gateway&lt;/b&gt;: one public entry point; user, product and order services are cluster-internal. order-service calls product-service synchronously so prices never come from the client." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#CCCCCC;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="520" y="960" width="800" height="70" as="geometry"/></mxCell><mxCell id="c64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#326CE5;strokeWidth=2;fontSize=10;fontColor=#326CE5;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c65" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#326CE5;strokeWidth=2;fontSize=10;fontColor=#326CE5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c8" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c66" value="/" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#326CE5;strokeWidth=2;fontSize=10;fontColor=#326CE5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c32" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c67" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#326CE5;strokeWidth=2;fontSize=10;fontColor=#326CE5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c33" target="c38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c68" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArro