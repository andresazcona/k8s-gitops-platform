rvice&lt;br&gt;Errors: 5xx ratio per service&lt;br&gt;Duration: p95 latency per service&lt;br&gt;Stat tiles: availability, % under 250 ms&lt;br&gt;HPA replicas: current vs desired" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#CCCCCC;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1470" y="110" width="240" height="150" as="geometry"/></mxCell><mxCell id="c22" value="traces&lt;br&gt;OTLP :4318" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7280;strokeWidth=2;fontSize=10;fontColor=#6B7280;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=1;exitY=0.152;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="OTLP/gRPC :4317" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7280;strokeWidth=2;fontSize=10;fontColor=#6B7280;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="metrics&lt;br&gt;pull :9464" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7280;strokeWidth=2;fontSize=10;fontColor=#6B7280;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=1;exitY=0.41;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c4" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="PromQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7280;strokeWidth=2;fontSize=10;fontColor=#6B7280;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="c17" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="TraceQL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7280;strokeWidth=2;fontSize=10;fontColor=#6B7280;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c16" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="firing alerts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#B3261E;strokeWidth=2;fontSize=10;fontColor=#B3261E;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="sidecar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6B7280;strokeWidth=2;fontSize=10;fontColor=#6B7280;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c20" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value='&lt;b style="font-size:15px;"&gt;Service level objectives (gateway = user-facing boundary)&lt;/b&gt;' style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="900" height="30" as="geometry"/></mxCell><mxCell id="c30" value='&lt;b&gt;SLO 1 · Availability 99.5%&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;"&gt;SLI: share of gateway requests that are not 5xx (probe routes excluded)&lt;br&gt;window: 30 days · error budget: 0.5% of requests (~3h 36m of full outage)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#B3261E;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="735" width="560" height="90" as="geometry"/></mxCell><mxCell id="c31" value='&lt;b&gt;SLO 2 · Latency&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;"&gt;SLI: share of gateway requests served in under 250 ms&lt;br&gt;objective: 95% of requests (p95 &amp;lt; 250 ms)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#ffffff;strokeColor=#D6B656;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="845" width="560" height="80" as="geometry"/></mxCell><mxCell id="c32" value='&lt;b&gt;Alert ErrorBudgetFastBurn · critical&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;"&gt;burn rate &amp;gt; 14.4x on BOTH 1h and 5m windows (5xx ratio &amp;gt; 7.2%), for 2m&lt;br&gt;spends 2% of the 30-day budget in 1 hour (SRE workbook multi-window)&lt;br&gt;the short window makes it reset fast once the incident is over&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FDECEA;strokeColor=#B3261E;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="660" y="730" width="590" height="100" as="geometry"/></mxCell><mxCell id="c33" value='&lt;b&gt;Alert LatencySLOBreach · warning&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;"&gt;share of requests under 250 ms &amp;lt; 95% over 30m, for 10m&lt;br&gt;needs a histogram bucket boundary at 0.25 s (OTel default buckets have it)&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#FFF8E1;strokeColor=#D6B656;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="660" y="845" width="590" height="80" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Recording rules&lt;/b&gt; (per service)&lt;br&gt;slo:error_ratio:rate5m, :rate1h&lt;br&gt;slo:fast_ratio:rate30m&lt;br&gt;&lt;br&gt;&lt;b&gt;Metric labels used&lt;/b&gt;&lt;br&gt;http_response_status_code, http_route, service, namespace" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#CCCCCC;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1310" y="735" width="330" height="200" as="geometry"/></mxCell><mxCell id="c35" value="" style="ellipse;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="600" y="780" width="1" height="1" as="geometry"/></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#B3261E;strokeWidth=1.5;fontSize=10;fontColor=#B3261E;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c35" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="" style="ellipse;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="600" y="885" width="1" height="1" as="geometry"/></mxCell><mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#D6B656;strokeWidth=1.5;fontSize=10;fontColor=#D6B656;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c37" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="&lt;b&gt;What a trace shows&lt;/b&gt;&lt;br&gt;One request through the gateway fans out to user / product / order spans, including the MongoDB call and order-service's HTTP call to product-service (W3C trace context propagates automatically). Spans carry k8s.namespace, k8s.pod and deployment.environment from the collector." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#CCCCCC;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="960" width="560" height="130" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Capacity link&lt;/b&gt;&lt;br&gt;The k6 load test (k6/load.js) hammers /api/users/login (scrypt, CPU bound). CPU crosses the 70% HPA target, replicas go 1 -&gt; 4, and the HPA panel plus the p95 panel show the recovery." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#CCCCCC;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="660" y="960" width="590" height="130" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;Not in scope&lt;/b&gt;: logs (stdout only), exemplars, long-term storage (Tempo runs on local disk; use S3 / GCS in a real cluster)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#CCCCCC;fontColor=#333333;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1310" y="960" width="330" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
